<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Entity Framework 6.3 and later run on modern .NET, so the runtime upgrade (case 01) and the change of
         data access library (this case) can be two separate steps. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OrderDesk.Data</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.1" />
  </ItemGroup>
</Project>
