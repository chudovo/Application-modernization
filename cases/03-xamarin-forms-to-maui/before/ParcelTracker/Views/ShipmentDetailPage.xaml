<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParcelTracker.Views.ShipmentDetailPage"
             Title="{Binding Title}">
    <ScrollView>
        <StackLayout Padding="16" Spacing="8">
            <Label Text="{Binding Shipment.RecipientName}" FontSize="Large" FontAttributes="Bold" />
            <Label Text="{Binding Shipment.City}" />
            <Label Text="{Binding Shipment.CountryCode}" />
            <Label Text="{Binding StatusLabel}" TextColor="{Binding Shipment.Status, Converter={StaticResource StatusToColor}}" FontAttributes="Bold" />
            <Label Text="{Binding DeliveredText}" />
            <Label Text="{Binding Shipment.Price, StringFormat='{0:0.00} EUR'}" />
            <Label Text="{Binding Shipment.CreatedBy, StringFormat='Created by {0}'}" TextColor="#616161" />
            <Button Text="Mark in transit" Command="{Binding MarkInTransitCommand}" IsVisible="{Binding CanMarkInTransit}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Mark delivered" Command="{Binding MarkDeliveredCommand}" IsVisible="{Binding CanMarkDelivered}" Style="{StaticResource PrimaryButton}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
        </StackLayout>
    </ScrollView>
</ContentPage>
