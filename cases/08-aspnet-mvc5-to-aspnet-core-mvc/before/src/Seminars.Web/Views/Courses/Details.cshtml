@model Course
@{ ViewBag.Title = Model.Title; }
<h1>@Model.Title</h1>
<p id="description">@Model.Description</p>
<p id="price">Preis: @Model.Price.ToString("N2") EUR</p>
<p id="start">Beginn: @Model.Start.ToString("d")</p>
<a id="register" href="@Url.Action("Create", "Registrations", new { courseId = Model.Id })">Jetzt anmelden</a>
