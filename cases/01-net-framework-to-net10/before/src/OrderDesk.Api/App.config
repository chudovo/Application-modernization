<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework" requirePermission="false" />
  </configSections>
  <appSettings>
    <add key="VatRate" value="0.19" />
    <add key="ApiKey" value="change-me" />
    <add key="BaseAddress" value="http://localhost:5080/" />
  </appSettings>
  <connectionStrings>
    <add name="OrderDesk" providerName="System.Data.SqlClient"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=OrderDesk;Integrated Security=true" />
  </connectionStrings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
