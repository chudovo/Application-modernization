[
  { "name": "health needs no API key",
    "request": { "method": "GET", "path": "/api/health" },
    "expect": { "status": 200, "body": { "Status": "ok" } } },

  { "name": "missing API key is rejected with the legacy error shape",
    "request": { "method": "GET", "path": "/api/orders/1" },
    "expect": { "status": 401, "body": { "Message": "API key is missing or invalid." } } },

  { "name": "get order returns PascalCase JSON, numeric enums and UTC dates",
    "request": { "method": "GET", "path": "/api/orders/1", "apiKey": true },
    "expect": { "status": 200, "body": {
      "Id": 1, "CustomerName": "Northwind Traders", "Status": 0, "CreatedUtc": "2026-01-10T09:30:00Z",
      "Lines": [
        { "Sku": "SKU-100", "Quantity": 2, "UnitPrice": 49.90, "LineTotal": 99.80 },
        { "Sku": "SKU-200", "Quantity": 1, "UnitPrice": 120.00, "LineTotal": 120.00 } ],
      "Subtotal": 219.80, "DiscountPercent": 0, "NetTotal": 219.80, "VatTotal": 41.76, "GrossTotal": 261.56 } } },

  { "name": "unknown order is a 404 with an empty body",
    "request": { "method": "GET", "path": "/api/orders/999", "apiKey": true },
    "expect": { "status": 404, "emptyBody": true } },

  { "name": "filter orders by customer",
    "request": { "method": "GET", "path": "/api/orders?customerId=1", "apiKey": true },
    "expect": { "status": 200, "bodyIds": [1, 3] } },

  { "name": "filter orders by numeric status",
    "request": { "method": "GET", "path": "/api/orders?status=1", "apiKey": true },
    "expect": { "status": 200, "bodyIds": [2] } },

  { "name": "seeded gold order carries the stacked discount",
    "request": { "method": "GET", "path": "/api/orders/2", "apiKey": true },
    "expect": { "status": 200, "bodyPartial": {
      "CustomerName": "Alpine Tools GmbH", "Status": 1, "Subtotal": 1500.00, "DiscountPercent": 7,
      "NetTotal": 1395.00, "VatTotal": 265.05, "GrossTotal": 1660.05 } } },

  { "name": "create order returns 201, a Location header and computed totals",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true,
      "body": { "CustomerId": 2, "Lines": [ { "Sku": "SKU-300", "Quantity": 4, "UnitPrice": 150.00 } ] } },
    "expect": { "status": 201, "locationEndsWith": "/api/orders/4", "body": {
      "Id": 4, "CustomerName": "Alpine Tools GmbH", "Status": 0, "CreatedUtc": "2026-01-15T10:00:00Z",
      "Lines": [ { "Sku": "SKU-300", "Quantity": 4, "UnitPrice": 150.00, "LineTotal": 600.00 } ],
      "Subtotal": 600.00, "DiscountPercent": 5, "NetTotal": 570.00, "VatTotal": 108.30, "GrossTotal": 678.30 } } },

  { "name": "request property names are matched case-insensitively",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true,
      "body": { "customerId": 1, "lines": [ { "sku": "SKU-100", "quantity": 1, "unitPrice": 49.90 } ] } },
    "expect": { "status": 201, "bodyPartial": { "Id": 4, "NetTotal": 49.90, "VatTotal": 9.48, "GrossTotal": 59.38 } } },

  { "name": "numbers sent as strings are accepted, as old clients send them",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true,
      "body": { "CustomerId": 1, "Lines": [ { "Sku": "SKU-100", "Quantity": "3", "UnitPrice": "49.90" } ] } },
    "expect": { "status": 201, "bodyPartial": { "Subtotal": 149.70, "GrossTotal": 178.14 } } },

  { "name": "VAT-exempt customer pays no VAT",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true,
      "body": { "CustomerId": 3, "Lines": [ { "Sku": "SKU-200", "Quantity": 2, "UnitPrice": 120.00 } ] } },
    "expect": { "status": 201, "bodyPartial": { "NetTotal": 240.00, "VatTotal": 0, "GrossTotal": 240.00 } } },

  { "name": "order without lines is a 400 with a Message",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true, "body": { "CustomerId": 1, "Lines": [] } },
    "expect": { "status": 400, "body": { "Message": "Order must contain at least one line." } } },

  { "name": "unknown customer is a 400 with a Message",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true,
      "body": { "CustomerId": 42, "Lines": [ { "Sku": "SKU-100", "Quantity": 1, "UnitPrice": 49.90 } ] } },
    "expect": { "status": 400, "body": { "Message": "Customer 42 does not exist." } } },

  { "name": "empty request body is a 400 with a Message",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true, "rawBody": "" },
    "expect": { "status": 400, "body": { "Message": "Request body is missing or malformed." } } },

  { "name": "malformed JSON is a 400 with a Message",
    "request": { "method": "POST", "path": "/api/orders", "apiKey": true, "rawBody": "{ \"CustomerId\": 1, \"Lines\": [ " },
    "expect": { "status": 400, "body": { "Message": "Request body is missing or malformed." } } },

  { "name": "cancel a new order",
    "request": { "method": "POST", "path": "/api/orders/1/cancel", "apiKey": true },
    "expect": { "status": 200, "bodyPartial": { "Id": 1, "Status": 3 } } },

  { "name": "shipped order cannot be cancelled",
    "request": { "method": "POST", "path": "/api/orders/3/cancel", "apiKey": true },
    "expect": { "status": 409, "body": { "Message": "Order 3 is already shipped and cannot be cancelled." } } }
]
